<header class="navbar">
    <a href="/images/drexel_logo.png" class="navbar-logo"></a>

    <nav class="navbar-icons">
        <a href="/auctions" title="Auctions" aria-label="Auctions"
           class="<%= active === 'auctions' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
        </a>

        <a href="/trade" title="Trade" aria-label="Trade"
           class="<%= active === 'trade' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3l4 4-4 4"/><path d="M3 7h18"/><path d="M7 21l-4-4 4-4"/><path d="M21 17H3"/></svg>
        </a>

        <a href="/friends" title="Friends" aria-label="Friends"
           class="<%= active === 'friends' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/></svg>
        </a>

        <a href="/notifications" title="Notifications" aria-label="Notifications"
           class="<%= active === 'notifications' ? 'active' : '' %>">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
        </a>
    </nav>

    <div class="profile-menu">
<!--        Blank for now. To add the picture later, put this inside the button:-->
        <button type="button" id="profile-btn" class="profile-btn"
                aria-haspopup="true" aria-expanded="false" aria-controls="profile-dropdown"
                aria-label="Open profile menu"></button>

        <ul id="profile-dropdown" class="dropdown" hidden>
            <li><a href="/account">View Profile</a></li>
            <li><a href="/listings">My Listings</a></li>
            <li><a href="/src/settings.html">Settings</a></li>
            <li>
                <form action="/logout" method="POST">
                    <button type="submit">Log Out</button>
                </form>
            </li>
        </ul>
    </div>
</header>

<script src="/js/navbar.js" defer></script>